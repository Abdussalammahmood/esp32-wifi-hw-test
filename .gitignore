# Firmware build artefacts only.
# The firmware SOURCE is committed on purpose - including managed_components/ and
# dependencies.lock - so both projects build offline without the component registry.
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old

# python
__pycache__/
*.pyc
.venv/
venv/

# run logs (reports in results/ are meant to be committed)
*.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
